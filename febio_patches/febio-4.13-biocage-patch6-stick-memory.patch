+								if (!data.m_bstick)
+								{
+									// BIOCAGE patch 6: slip traction t = -pn nu + mu pn s, s = trial tangential traction direction,
+									// t_trial = Lt + eps (xt - xo); d t / d(dg) = eps [ nu nu - mu s nu + (mu pn / |tt|) (I - nu nu - s s) ]
+									vec3d xo = ss.Local2Global(se, j);
