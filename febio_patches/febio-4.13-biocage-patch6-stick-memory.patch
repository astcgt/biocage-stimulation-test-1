+//-----------------------------------------------------------------------------
+//! BIOCAGE patch 7 (2026-11-07): the pilot options are switched by environment variables instead of input-file parameters, so that
+//! (1) the sliding-elastic parameter list - and with it the layout of FEBio's restart dump - is identical to production FEBio
+//! (FEParamContainer::Serialize refuses a dump whose parameter count differs), and (2) a window restarted from a production
+//! checkpoint (the t 3.5 state of the friction runs) can switch the friction treatment on for the window only. Applied to
+//! FRICTIONAL interfaces only (the frictionless facet contacts are untouched); every change is written to the log (feLog, not filtered by the log level) so a run
+//! carries its own evidence. Without the variables nothing changes (production behaviour).
+//!   BIOCAGE_STICK_MEMORY=1               patch-6 stick memory (stick points kept across increments, slipped points return-mapped)
+//!   BIOCAGE_CAGE_LAUGON=<tol>[,<maxaug>] augmented Lagrangian enforcement, augmentation tolerance tol, minaug 1, maxaug (default 10)
+void FESlidingElasticInterface::ApplyBiocageEnv()
+{
+    if (m_mu <= 0.0) return;
+    const char* s = getenv("BIOCAGE_STICK_MEMORY");
+    if (s)
+    {
+        m_bstickmem = (atoi(s) != 0);
+        feLog("BIOCAGE patch 7: interface '%s': stick_memory = %d (env BIOCAGE_STICK_MEMORY)", GetName().c_str(), (int)m_bstickmem);
+    }
+    const char* a = getenv("BIOCAGE_CAGE_LAUGON");
+    if (a)
+    {
+        double tol = atof(a); int maxaug = 10;
+        const char* c = strchr(a, ','); if (c) maxaug = atoi(c + 1);
+        m_laugon = FECore::AUGLAG_METHOD; m_atol = tol; m_naugmin = 1; m_naugmax = maxaug;
+        feLog("BIOCAGE patch 7: interface '%s': laugon = AUGLAG, tolerance %g, minaug 1, maxaug %d (env BIOCAGE_CAGE_LAUGON)", GetName().c_str(), tol, maxaug);
+    }
+}
