@@ -55,6 +55,16 @@ public:
 	//! spatial tangent
 	tens4ds DevTangent(FEMaterialPoint& mp) override;
 
+	// BIOCAGE patch 5: volumetric response about the prestrained volume (elastic J = J * Jp); the stock wrapper applied the
+	// prestrain to the deviatoric part only, so a prestrain with det != 1 could change shape but never volume.
+	double U(double J) override { return FEUncoupledMaterial::U(J * Jp()); }
+	double UJ(double J) override { return FEUncoupledMaterial::UJ(J * Jp()); }
+	double UJJ(double J) override { double jp = Jp(); return jp * FEUncoupledMaterial::UJJ(J * jp); }
+
+private:
+	double Jp() const;	// current prestrain det (patch 5b: from the gradient's ramp; else the last DevStress value)
+	double m_Jp = 1.0;	// det of the prestrain gradient at the last DevStress call
+
 protected:
 	//! calculate prestrain deformation gradient
 	mat3d PrestrainGradient(FEMaterialPoint& mp);
