+//-----------------------------------------------------------------------------
+//! BIOCAGE patch 6 (2026-11-06, parameter stick_memory): increment-start anchor update replacing InitSlidingSurface.
+//! Original FEBio copies the fresh projection into (m_rsp, m_pmep) at every increment start, so a point that STICKS loses
+//! its elastic tangential offset each increment and the body creeps by ~ t_s / eps per increment under a constant load
+//! (measured on the cage: drift proportional to the increment count at a fixed angle, 0.05-0.46 mm; block: 0.015 mm per
+//! increment at E 10 MPa). Here (1) a point that ended the last converged increment in stick keeps its stick point;
+//! (2) a point that slipped is re-anchored on the friction cone (return mapping, Wriggers 2006 ch. 5): the trial stick
+//! traction of the next increment equals the slip traction (nu + mu s1)(-pn) instead of restarting from zero;
+//! (3) new or lost contact behaves as before. The friction law itself (Coulomb return map in ContactTraction) is unchanged.
+void FESlidingElasticInterface::InitStickMemory(FESlidingElasticSurface& ss, FESlidingElasticSurface& ms)
+{
+    double psf = GetPenaltyScaleFactor();
+    for (int i=0; i<ss.Elements(); ++i)
+    {
+        FESurfaceElement& el = ss.Element(i);
+        int nint = el.GaussPoints();
+        for (int j=0; j<nint; ++j)
+        {
+            FESlidingElasticSurface::Data& data = static_cast<FESlidingElasticSurface::Data&>(*el.GetMaterialPoint(j));
+            if (data.m_bstick && data.m_pmep) continue;                       // (1) keep the stick point
+            FESurfaceElement* pme = data.m_pme;
+            if (pme && (m_mu > 0) && (data.m_gap > 0))                        // (2) return mapping of a slipped point
+            {
+                double eps = m_epsn*data.m_epsn*psf;
+                double pn = data.m_Lmd + eps*data.m_gap; if (!m_btension) pn = MBRACKET(pn);
+                double s1n = data.m_s1.norm();
+                if ((pn > 0) && (eps > 0) && (s1n > 0))
+                {
+                    vec3d q = ms.Local2Global(*pme, data.m_rs[0], data.m_rs[1]);
+                    vec3d xt = q - data.m_s1*(m_mu*pn/(eps*s1n));
+                    double rs[2] = { data.m_rs[0], data.m_rs[1] }; double g;
+                    if (ms.Intersect(*pme, xt, data.m_nu, rs, g, m_stol, false)) { data.m_rsp = vec2d(rs[0], rs[1]); data.m_pmep = pme; continue; }
+                }
+            }
+            data.m_rsp = data.m_rs;                                            // (3) as before
+            data.m_pmep = data.m_pme;
+        }
+    }
+}
